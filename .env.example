# Copie para .env:  cp .env.example .env
# Mesmo arquivo usado pelo servidor, seeds e job SEFAZ.

# Banco SQLite local (desenvolvimento)
DATABASE_URL=file:./local.db

# API Express + tRPC
PORT=3000
NODE_ENV=development
JWT_SECRET=dev_secret_altere_em_producao

# App Expo — URL do servidor (obrigatório no celular físico/emulador)
# 1) ipconfig → IPv4 do PC na mesma rede Wi-Fi do celular
# 2) Ao subir o server, confira a porta no log (padrão 3000; se ocupada, usa 3001+)
# 3) Use a MESMA porta aqui: http://SEU_IP:PORTA
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:3000

# Emulador Android: http://10.0.2.2:3000
# Web local: http://localhost:3000

# OAuth (opcional — não necessário para preços/postos SEFAZ)
# EXPO_PUBLIC_APP_ID=
# EXPO_PUBLIC_OAUTH_PORTAL_URL=
# EXPO_PUBLIC_OAUTH_SERVER_URL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
